{{ 'section-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shop.js' | asset_url }}" defer="defer"></script>

<section class="sec" id="shop">
  <div class="wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="panel-head">
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>{%- endif -%}
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <i></i>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank -%}
      <div class="shelf">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="lede">Select a collection in the section settings to show products here.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "shopify-section--shop-grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show",
      "min": 2, "max": 24, "step": 1, "default": 8 }
  ],
  "presets": [
    { "name": "Shop grid" }
  ]
}
{% endschema %}
